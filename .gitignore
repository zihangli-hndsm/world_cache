.conda/
.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
*.py[cod]
core
core.*
*.egg-info/
outputs/runs/*
outputs/plots/*
outputs/tables/*
outputs/reports/environment_report.txt
outputs/reports/latest_session_start.txt

# Keep only the review-date handoff and the figure source used by the paper;
# historical experiment reports, bundles, and environment snapshots stay out
# of the working tree and release snapshots.
outputs/reports/*
!outputs/reports/.gitkeep
!outputs/reports/20260923_review_update.md
!outputs/reports/20260923_review_figures/
!outputs/reports/20260923_review_figures/**

# LaTeX build products are reproducible and should not enter source commits.
paper/*.aux
paper/*.log
paper/*.out
outputs/day1_alignment_examples/
data/
checkpoints/
wandb/

# Local research bookkeeping and prompt material; keep these out of a public
# repository unless a release explicitly curates them.
logs/
SESSION_STATE.md
SESSION_HANDOFF.md
external_prompts/

!outputs/runs/.gitkeep
!outputs/plots/.gitkeep
!outputs/tables/.gitkeep
